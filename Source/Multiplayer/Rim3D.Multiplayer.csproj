<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Recovery.Rim3D.Multiplayer</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GameRoot Condition="'$(GameRoot)' == ''">D:/SteamLibrary/steamapps/common/RimWorld</GameRoot>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameRoot)/RimWorldWin64_Data/Managed</GameManaged>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(GameRoot)/Mods/HarmonyMod/Current/Assemblies/0Harmony.dll</HarmonyPath>
    <MultiplayerRoot Condition="'$(MultiplayerRoot)' == ''">$(GameRoot)/Mods/Multiplayer</MultiplayerRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs" />
    <EmbeddedResource Include="../../Version.txt" LogicalName="RimVision.Version.txt" />
    <ProjectReference Include="../RimVision/Rim3D.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)/UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="0MultiplayerAPI"><HintPath>$(MultiplayerRoot)/Assemblies/0MultiplayerAPI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
